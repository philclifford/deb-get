DEFVER=1
get_github_releases "mucommander/mucommander" "latest"
if [ "${ACTION}" != prettylist ]; then
    URL=$(grep -m 1 "browser_download_url.*\.deb\"" <<< $(sed "s/,/\n/g" "${CACHE_FILE}")  | cut -d '"' -f 4)
    # the tag  is in the format "1.5.2-1" but the version published is "1.5.2" so we need to cut the string from the filename instead of the tag
    VERSION_PUBLISHED="$(cut -d '_' -f 2 <<< "${URL}")"
fi
PRETTY_NAME="muCommander"
WEBSITE="https://www.mucommander.com/"
SUMMARY="a lightweight, cross-platform file manager"
