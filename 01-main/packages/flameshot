DEFVER=1
ARCHS_SUPPORTED="amd64 arm64 armhf"
CODENAMES_SUPPORTED="trixie noble resolute" # only packaged for Debian 13 Ubuntu 26.04, Ubuntu 24.04
MINIMUM_DEB_GET_VERSION="0.4.7"
# required for post_download
if ! dpkg --compare-versions "${VERSION}" ge "${MINIMUM_DEB_GET_VERSION}"; then
    if [ "${ACTION}" == "install" ]; then
        fancy_message  warn "deb-get Version ${VERSION} does not support $APP. Please use version ${MINIMUM_DEB_GET_VERSION} or later."
    fi
fi
get_github_releases "flameshot-org/flameshot" "" --no-filter #"latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 -E "browser_download_url.*${UPSTREAM_ID}-${UPSTREAM_RELEASE}.*${HOST_ARCH}\.(deb|zip)\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    # if [[ "${FILE}" =~ .*\.zip$ ]]; then
    function post_download() {
        local deb
        deb=$(unzip -Z1 "${CACHE_DIR}/${FILE}" "*.deb" 2>/dev/null | head -1) || return 1
        ${ELEVATE} unzip -jqo "${CACHE_DIR}/${FILE}" "${deb}" -d "${CACHE_DIR}" || return 1
        echo "Extracted ${deb} from ${FILE}"
        export FILE="$(basename "${deb}")"
        echo "File set to " ${FILE}
    }
