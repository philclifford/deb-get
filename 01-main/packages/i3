CODENAMES_SUPPORTED="jammy noble plucky resolute stonking"
# They claim to support supported releases of Ubuntu but only have repos for certain versions
# so we have to mangle the codename to match the available repository names and monitor for changes in the upstream repository structure
case "${UPSTREAM_CODENAME}" in
    plucky|resolute|stonking)
        AVAILABLE_REPO="questing"
        ;;
    *)
        AVAILABLE_REPO="${UPSTREAM_CODENAME}"
        ;;
esac

